  "project": {
    "schemaVersion": 1,
    "mainStory": {
      "purpose": "Introduce the HUANDENG open-source project on GitHub: the slide-maintenance problem it addresses, its model, a real working session, and how to contribute.",
      "audience": "Researchers, technical slide authors and open-source contributors meeting the project for the first time.",
      "takeaway": "Keep one editable source of slides, build every talk from it, record intent beside it, and let people and agents change it through one reviewable writer."
    },
    "sections": [
      {
        "id": "sec-model",
